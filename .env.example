# J.A.R.V.I.S Environment Variables

# Google Gemini (Primary LLM for Routing and General Chat)
# Get from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Groq (Fallback LLM & Ultra-fast Whisper STT)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Sarvam (Optional: For native Hindi TTS if not using Edge-TTS)
# Get from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
